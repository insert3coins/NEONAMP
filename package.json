{
  "name": "neonamp",
  "version": "1.0.0",
  "description": "Self-hosted Winamp-style web music player with file-based playlists. insert3coins edition.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "cargo run --release --manifest-path desktop/Cargo.toml",
    "desktop:build": "cargo build --release --manifest-path desktop/Cargo.toml"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "music-metadata": "^11.0.0",
    "ws": "^8.18.0"
  }
}